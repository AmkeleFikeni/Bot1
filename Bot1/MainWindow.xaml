<Window x:Class="Bot1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="750"
        Width="1300"
        Background="#0A0F1F"
        FontFamily="Segoe UI">

    <Grid>

        <Grid.Background>
            <SolidColorBrush Color="#0A0F1F"/>
        </Grid.Background>
        <!-- Overlay -->
        <Rectangle Fill="#AA0A0F1F"/>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT PANEL ================= -->

            <Border Grid.Column="0"
                    Background="#151B2D"
                    BorderBrush="#00C2FF"
                    BorderThickness="0,0,2,0">

                <StackPanel Margin="20">

                    <Border Width="180"
                            Height="180"
                            CornerRadius="90"
                            BorderBrush="#00C2FF"
                            BorderThickness="3"
                            Margin="0,20">

                        <Image x:Name="BotLogoImage"
                               Source="pack://application:,,,/Images/botlogo.png"
                               Stretch="UniformToFill"/>

                    </Border>

                    <TextBlock Text="CYBER AWARENESS BOT"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Your intelligent cybersecurity assistant."
                               FontSize="14"
                               Foreground="#CCCCCC"
                               Margin="10"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <Separator Margin="0,15"/>

                    <!-- Quiz Score -->

                    <TextBlock Text="QUIZ SCORE"
                               Foreground="#00C2FF"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="QuizScoreText"
                               Text="0 / 0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,5"/>

                    <Separator Margin="0,15"/>

                    <!-- Memory -->

                    <TextBlock Text="MEMORY"
                               Foreground="#00C2FF"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="MemoryTextBlock"
                               Text="No information remembered."
                               Foreground="White"
                               Margin="5"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <Separator Margin="0,15"/>

                    <!-- Last Topic -->

                    <TextBlock Text="LAST TOPIC"
                               Foreground="#00C2FF"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="LastTopicText"
                               Text="None"
                               Foreground="White"
                               Margin="5"
                               TextAlignment="Center"/>

                </StackPanel>

            </Border>

            <!-- ================= CHAT PANEL ================= -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>

                <!-- Quick Commands -->

                <WrapPanel Grid.Row="0"
                           HorizontalAlignment="Center"
                           Margin="10">
                    <Button Content="Restart Quiz"
                              Width="120"
                              Margin="5"
                              Click="RestartQuizButton_Click"/>

                    <Button x:Name="StartQuizButton"
                            Content="Start Quiz"
                            Width="120"
                            Margin="5"
                            Click="StartQuizButton_Click"/>

                    <Button x:Name="RememberButton"
                            Content="Remember"
                            Width="120"
                            Margin="5"
                            Click="RememberButton_Click"/>

                    <Button x:Name="ShowLogButton"
                            Content="Show Log"
                            Width="120"
                            Margin="5"
                            Click="ShowLogButton_Click"/>

                    <Button x:Name="TellMoreButton"
                            Content="Tell Me More"
                            Width="120"
                            Margin="5"
                            Click="TellMoreButton_Click"/>
                </WrapPanel>

                <!-- Chat Area -->

                <Border Grid.Row="1"
                        Margin="15"
                        Background="#1E1E2F"
                        CornerRadius="20"
                        BorderBrush="#00C2FF"
                        BorderThickness="2">

                    <ScrollViewer x:Name="ChatScrollViewer"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel x:Name="ChatPanel"
                                    Margin="15"/>

                    </ScrollViewer>

                </Border>

                <!-- Input -->

                <Grid Grid.Row="2"
                      Margin="15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="UserInputTextBox"
                             Grid.Column="0"
                             FontSize="16"
                             Padding="12"
                             Height="50"
                             VerticalContentAlignment="Center"
                             Background="#2B2B40"
                             Foreground="White"
                             BorderBrush="#00C2FF"
                             BorderThickness="2"
                             KeyDown="UserInputTextBox_KeyDown"/>

                    <Button x:Name="SendButton"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Content="SEND"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="#00C2FF"
                            Foreground="Black"
                            Click="SendButton_Click"/>

                </Grid>

            </Grid>

            <!-- ================= RIGHT PANEL ================= -->

            <Grid Grid.Column="2"
                  Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Task Assistant -->

                <Border Grid.Row="0"
                        Background="#1E1E2F"
                        CornerRadius="15"
                        BorderBrush="#00C2FF"
                        BorderThickness="2"
                        Margin="5">

                    <Grid Margin="12">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="TASK ASSISTANT"
                                   Foreground="#00C2FF"
                                   FontWeight="Bold"
                                   FontSize="18"/>

                        <TextBox x:Name="TaskTextBox"
                                 Grid.Row="1"
                                 Height="35"
                                 Margin="0,10,0,5"
                                 Background="#2B2B40"
                                 Foreground="White"
                                 BorderBrush="#00C2FF"/>

                        <DatePicker x:Name="ReminderDatePicker"
                                    Grid.Row="2"
                                    Margin="0,0,0,5"/>

                        <Button x:Name="AddTaskButton"
                                Grid.Row="3"
                                Height="35"
                                Content="Add Task"
                                Background="#00C2FF"
                                Foreground="Black"
                                Click="AddTaskButton_Click"/>
                        <Button x:Name="CompleteTaskButton"
                                Grid.Row="3"
                                Margin="0,45,0,0"
                                Height="35"
                                Content="Mark Complete"
                                Background="#00C2FF"
                                Foreground="Black"
                                Click="CompleteTaskButton_Click"/>

                        <ListBox x:Name="TaskListBox"
                                 Grid.Row="4"
                                 Margin="0,10,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"/>

                    </Grid>

                </Border>

                <!-- Activity Log -->

                <Border Grid.Row="1"
                        Background="#1E1E2F"
                        CornerRadius="15"
                        BorderBrush="#00C2FF"
                        BorderThickness="2"
                        Margin="5">

                    <Grid Margin="12">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="ACTIVITY LOG"
                                   Foreground="#00C2FF"
                                   FontWeight="Bold"
                                   FontSize="18"/>

                        <ListBox x:Name="ActivityLogListBox"
                                 Grid.Row="1"
                                 Margin="0,10,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>